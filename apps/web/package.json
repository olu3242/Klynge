{
  "name": "@klynge/web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --conditions=react-server --test \"src/**/*.test.ts\"",
    "bundle:check": "node scripts/check-client-bundle.mjs",
    "corpus:build": "node --conditions=react-server scripts/build-corpus.ts",
    "corpus:record": "node --conditions=react-server scripts/record-corpus.ts --live",
    "e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:rls && npm run build && npm run bundle:check && npm run e2e",
    "test:rls": "node --test --test-timeout=120000 \"test/rls/*.test.ts\"",
    "rls:hosted": "node --conditions=react-server scripts/rls-hosted.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.27",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pg": "^8.23.1",
    "playwright-core": "^1.56.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.1"
  }
}
