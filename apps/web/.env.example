# Klynge web — copy to .env.local. Server-only values MUST NOT be prefixed NEXT_PUBLIC_.

# ── Extraction ───────────────────────────────────────────────────────────────
# mock (default; replays test/corpus recordings, no network) | claude (requires server-side credentials)
KLYNGE_EXTRACTOR=mock
# Server-only. Either an API key...
ANTHROPIC_API_KEY=
# ...or Workload Identity Federation (SDK-native; used by .github/workflows/corpus-record.yml)
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_IDENTITY_TOKEN_FILE=

# ── Auth (Supabase Auth: Google OAuth + email magic link) ────────────────────
# supabase (default when NEXT_PUBLIC_SUPABASE_* are set) | disabled (anonymous trial only)
KLYNGE_AUTH=
# Public origin used for auth redirects (must be in Supabase Auth's redirect allow-list)
KLYNGE_SITE_URL=

# ── Persistence ──────────────────────────────────────────────────────────────
# memory (default, dev) | file (dev/e2e restart tests; KLYNGE_STORE_FILE) | supabase (user-bound client + RLS; apply supabase/migrations first)
KLYNGE_STORE=memory
KLYNGE_STORE_FILE=
SUPABASE_URL=https://mdshgiqynukrbkyxgmur.supabase.co
# Server-only. Never commit, never paste into chat, never expose to the browser.
# SERVICE ROLE ≠ USER AUTHORIZATION: used only by allow-listed admin operations (src/server/admin), never user CRUD.
SUPABASE_SERVICE_ROLE_KEY=
# Client-safe (RLS-scoped)
NEXT_PUBLIC_SUPABASE_URL=https://mdshgiqynukrbkyxgmur.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Privacy ──────────────────────────────────────────────────────────────────
# SESSION (processed, metadata-stripped images kept in memory until session reset) | NONE (discarded after extraction)
KLYNGE_IMAGE_RETENTION=SESSION

# ── Market data (DATA mode) ──────────────────────────────────────────────────
# none (default) | mock (offline recorded fixture) | polygon (Polygon/Massive aggregates; server-only key)
KLYNGE_PROVIDER=
KLYNGE_PROVIDER_FIXTURE=
POLYGON_API_KEY=
# Plans your account actually licenses (comma-separated): stocks, indices. MNQ (CME futures) is NOT served by this
# adapter — DATA mode stays BLOCKED (ENTITLEMENT_MISSING) until a licensed CME futures source is configured.
KLYNGE_POLYGON_PLANS=stocks
KLYNGE_POLYGON_BASE_URL=
# CME futures (MNQ front contract, rolled). Server-only. Datasets you actually license (e.g. GLBX.MDP3).
# Without them MNQ stays BLOCKED (ENTITLEMENT_MISSING) — NQ is never substituted.
DATABENTO_API_KEY=
KLYNGE_DATABENTO_DATASETS=

# ── Historical datasets (operator storage; never committed) ─────────────────
KLYNGE_DATASET_DIR=.klynge/datasets
KLYNGE_DATA_LICENSE=
KLYNGE_DATA_RETENTION_DAYS=

# ── Notifications ────────────────────────────────────────────────────────────
# none (default) | resend | mock (test mode only). Emails go only to the user's VERIFIED auth address.
KLYNGE_EMAIL=
RESEND_API_KEY=
KLYNGE_EMAIL_FROM=
# Bearer secret for POST /api/cron/notifications (in-process stores). Hosted: `npm run worker:notifications`.
KLYNGE_CRON_SECRET=

# ── Operators (server-only) ──────────────────────────────────────────────────
# Comma-separated verified emails allowed to open /app/ops. On Supabase the user ALSO needs
# app_metadata.klynge_role = "admin" (settable only with the service role).
KLYNGE_ADMIN_EMAILS=
KLYNGE_ACCOUNT_STORE_FILE=

# ── Test only (never in production; refused when VERCEL_ENV/KLYNGE_DEPLOYMENT=production) ───────────────
# KLYNGE_TEST_MODE=1 enables the x-klynge-now clock header, provider failure scenarios, KLYNGE_AUTH=mock and
# KLYNGE_EMAIL=mock. In a production build it additionally requires KLYNGE_E2E_RUN=1 (set only by scripts/e2e.mjs).
KLYNGE_TEST_MODE=
KLYNGE_TEST_AUTH_SECRET=
